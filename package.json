{
  "name": "animacion-app",
  "productName": "AnimacionApp",
  "version": "0.1.0",
  "description": "Aplicación profesional de ilustración y animación 2D open source y multiplataforma",
  "main": "src-tauri/src/main.rs",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build crates/oniri-brush-core --target web --out-dir ../../src/wasm/oniri-brush-core",
    "build": "vite build",
    "build:exe": "cmd /c \"set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && tauri build\"",
    "build:tauri": "cmd /c \"set PATH=%USERPROFILE%\\.cargo\\bin;%PATH% && tauri build\"",
    "preview": "vite preview",
    "app": "cmd /c start msedge --app=http://localhost:5173/",
    "desktop": "cargo run -p oniri-desktop",
    "desktop:build": "cargo build -p oniri-desktop --release",
    "tauri": "tauri"
  },
  "keywords": [
    "animation",
    "drawing",
    "tauri",
    "rust",
    "webgl",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "wasm-pack": "^0.15.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@types/sql.js": "^1.4.11",
    "fflate": "^0.8.3",
    "sql.js": "^1.15.1",
    "three": "^0.160.1"
  }
}
